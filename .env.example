# Copy this file to .env and fill in the provider keys you actually use.
# Every provider is independently optional -- only configure the ones you need.

# --- OpenAI -----------------------------------------------------------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ----------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_VERSION=2023-06-01

# --- Gemini (via Google's OpenAI-compatibility layer) --------------------
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- Generic OpenAI-compatible endpoint ----------------------------------
# Anything that speaks the OpenAI /chat/completions schema: Ollama (local),
# OpenRouter, Groq, Together, Mistral, DeepSeek, vLLM, LM Studio, etc.
GENERIC_API_KEY=
GENERIC_BASE_URL=
GENERIC_PROVIDER_LABEL=generic

# Provider used when a model name doesn't match any prefix rule.
DEFAULT_PROVIDER=openai

# --- Server -------------------------------------------------------------
HOST=0.0.0.0
PORT=8000

# --- Sanitizer toggles ----------------------------------------------------
MASK_EMAILS=true
MASK_API_KEYS=true
MASK_CREDIT_CARDS=true
MASK_SSN=true
MASK_PHONE_NUMBERS=true
MASK_IP_ADDRESSES=true
MASK_FULL_NAMES=false

# --- Response unmasking ---------------------------------------------------
ALLOW_RESPONSE_UNMASKING=true

# --- Auth / virtual keys ---------------------------------------------------
ENABLE_AUTH=true
MASTER_KEY_DAILY_BUDGET_USD=25.0
MASTER_KEY_RATE_LIMIT_RPM=120

# --- Cost circuit breaker ---------------------------------------------------
DEFAULT_DAILY_BUDGET_USD=5.0
DEFAULT_RATE_LIMIT_RPM=60

# --- Caching ----------------------------------------------------------------
ENABLE_CACHE=true
CACHE_TTL_SECONDS=3600

# --- Guardrails ---------------------------------------------------------
MAX_REQUEST_CHARS=400000

# --- Storage --------------------------------------------------------------
DB_PATH=llm_shield.db

LOG_LEVEL=INFO
